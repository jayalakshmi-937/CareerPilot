# ── CareerPilot Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# ── LLM Provider ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# ── Application ─────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./database/careerpilot.db

# ── ChromaDB ────────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=careerpilot_docs

# ── Embeddings ──────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=models/embedding-001   # Google Generative AI embeddings

# ── LLM Settings ────────────────────────────────────────────────────────────────
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ── RAG Settings ────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# ── Streamlit ───────────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
